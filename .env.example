# Created automatically when you connect a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Leave BLOB_READ_WRITE_TOKEN blank for fully offline development.
# Local data is written here and is ignored by Git.
LOCAL_TOURNAMENT_FILE=.local/tournament.json

# Never commit the real values.
ORGANIZER_PASSWORD=change-me
ORGANIZER_SESSION_SECRET=replace-with-a-long-random-secret
